{
  // ⚠️ "name" doit être EXACTEMENT le nom de votre Worker sur Cloudflare
  "name": "bcash-invitation",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "kv_namespaces": [
    // ⚠️ Remplacez par l'ID de votre KV « bcash-rsvp » (Storage & databases › KV)
    { "binding": "RSVP", "id": "COLLEZ_ICI_L_ID_DU_KV" }
  ],
  "keep_vars": true,
  "observability": { "enabled": true }
}
